<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tracking de Servicios - Dashboard</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Leaflet CSS y JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <!-- SheetJS para leer archivos Excel -->
    <script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        /* ===== ESTILOS ===== */
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', 'Segoe UI', sans-serif; }
        body { background: #f0f4f9; padding: 24px; }
        .dashboard { max-width: 1440px; margin: 0 auto; }

        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; flex-wrap: wrap; gap: 12px; }
        .header h1 { font-size: 28px; font-weight: 800; color: #0a1a2b; letter-spacing: -0.5px; }
        .header h1 i { color: #2563eb; margin-right: 12px; }
        .header .date { background: white; padding: 8px 20px; border-radius: 30px; box-shadow: 0 2px 8px rgba(0,0,0,0.04); color: #475569; font-size: 14px; font-weight: 500; }
        .header .date i { margin-right: 8px; color: #2563eb; }

        .filters { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; background: white; padding: 16px 20px; border-radius: 16px; box-shadow: 0 4px 16px rgba(0,0,0,0.04); align-items: center; border: 1px solid #e9eef3; }
        .filters label { font-weight: 600; color: #1e293b; font-size: 12px; text-transform: uppercase; letter-spacing: 0.3px; margin-right: 2px; }
        .filters select { padding: 8px 14px; border: 1px solid #dce1e8; border-radius: 30px; background: #f8fafc; font-size: 13px; outline: none; transition: 0.2s; cursor: pointer; color: #1e293b; font-weight: 500; }
        .filters select:focus { border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,0.12); }
        .filters input[type="date"] { padding: 8px 14px; border: 1px solid #dce1e8; border-radius: 30px; background: #f8fafc; font-size: 13px; outline: none; transition: 0.2s; cursor: pointer; color: #1e293b; font-weight: 500; }
        .filters input[type="date"]:focus { border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,0.12); }
        .filters .btn { background: #2563eb; color: white; border: none; padding: 8px 24px; border-radius: 30px; font-weight: 600; font-size: 13px; cursor: pointer; transition: 0.2s; margin-left: auto; }
        .filters .btn:hover { background: #1d4ed8; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(37,99,235,0.3); }

        .file-upload-section { display: flex; flex-wrap: wrap; gap: 10px; background: white; padding: 12px 20px; border-radius: 16px; box-shadow: 0 4px 16px rgba(0,0,0,0.04); border: 1px solid #e9eef3; margin-bottom: 28px; align-items: center; }
        .file-upload-section label { font-weight: 600; color: #1e293b; font-size: 12px; text-transform: uppercase; letter-spacing: 0.3px; }
        .file-upload-section input[type="file"] { padding: 6px 12px; border: 1px solid #dce1e8; border-radius: 30px; background: #f8fafc; font-size: 13px; cursor: pointer; }
        .file-upload-section .btn-upload { background: #22c55e; color: white; border: none; padding: 8px 20px; border-radius: 30px; font-weight: 600; font-size: 13px; cursor: pointer; transition: 0.2s; }
        .file-upload-section .btn-upload:hover { background: #16a34a; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(34,197,94,0.3); }
        .file-upload-section .btn-clear { background: #ef4444; color: white; border: none; padding: 8px 20px; border-radius: 30px; font-weight: 600; font-size: 13px; cursor: pointer; transition: 0.2s; }
        .file-upload-section .btn-clear:hover { background: #dc2626; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(239,68,68,0.3); }
        .file-upload-section .file-status { font-size: 13px; color: #64748b; font-weight: 500; margin-left: 4px; }
        .file-upload-section .file-status i { margin-right: 4px; }

        .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 18px; margin-bottom: 28px; }
        .kpi-card { background: white; border-radius: 16px; padding: 20px 22px; box-shadow: 0 4px 16px rgba(0,0,0,0.04); border-left: 5px solid #2563eb; transition: all 0.2s; }
        .kpi-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,0.07); }
        .kpi-card .label { font-size: 12px; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; display: flex; align-items: center; gap: 6px; }
        .kpi-card .label i { font-size: 14px; }
        .kpi-card .value { font-size: 34px; font-weight: 800; color: #0a1a2b; letter-spacing: -0.5px; }
        .kpi-card .sub { font-size: 13px; color: #64748b; margin-top: 4px; font-weight: 500; }
        .kpi-card.green { border-left-color: #22c55e; }
        .kpi-card.orange { border-left-color: #f59e0b; }
        .kpi-card.red { border-left-color: #ef4444; }
        .kpi-card.purple { border-left-color: #8b5cf6; }

        .chart-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 28px; }
        .chart-box { background: white; border-radius: 16px; padding: 18px 20px 14px 20px; box-shadow: 0 4px 16px rgba(0,0,0,0.04); border: 1px solid #e9eef3; transition: all 0.2s; }
        .chart-box:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.06); }
        .chart-box h3 { font-size: 14px; font-weight: 600; color: #1e293b; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
        .chart-box h3 i { color: #2563eb; font-size: 16px; }
        .chart-box canvas { width: 100% !important; max-height: 200px; }

        .map-wrapper { background: white; border-radius: 16px; padding: 18px 20px 16px 20px; box-shadow: 0 4px 16px rgba(0,0,0,0.04); border: 1px solid #e9eef3; margin-bottom: 28px; }
        .map-wrapper h3 { font-size: 14px; font-weight: 600; color: #1e293b; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
        .map-wrapper h3 i { color: #2563eb; font-size: 16px; }
        #map { height: 400px; border-radius: 12px; z-index: 1; border: 1px solid #e9eef3; }
        .map-legend { display: flex; gap: 20px; margin-top: 10px; flex-wrap: wrap; font-size: 13px; color: #475569; font-weight: 500; }
        .map-legend span { display: flex; align-items: center; gap: 6px; }
        .map-legend .dot { display: inline-block; width: 12px; height: 12px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.8); }
        .dot.green { background: #22c55e; }
        .dot.orange { background: #f59e0b; }
        .dot.red { background: #ef4444; }
        .dot.grey { background: #64748b; }

        .table-wrapper { background: white; border-radius: 16px; padding: 18px 20px 16px 20px; box-shadow: 0 4px 16px rgba(0,0,0,0.04); border: 1px solid #e9eef3; margin-bottom: 28px; overflow-x: auto; }
        .table-wrapper h3 { font-size: 14px; font-weight: 600; color: #1e293b; margin-bottom: 14px; display: flex; align-items: center; gap: 8px; }
        .table-wrapper h3 i { color: #2563eb; font-size: 16px; }
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        th { background: #f8fafc; color: #475569; font-weight: 600; padding: 10px 12px; text-align: left; border-bottom: 2px solid #e9eef3; white-space: nowrap; font-size: 12px; text-transform: uppercase; letter-spacing: 0.3px; }
        td { padding: 9px 12px; border-bottom: 1px solid #f1f5f9; color: #1e293b; }
        tr:hover td { background: #f8fafc; }
        .badge-estatus { display: inline-block; padding: 3px 12px; border-radius: 20px; font-size: 11px; font-weight: 600; letter-spacing: 0.2px; text-transform: uppercase; }
        .badge-estatus.otorgado { background: #dcfce7; color: #166534; }
        .badge-estatus.no-otorgado { background: #fee2e2; color: #991b1b; }
        .badge-estatus.proceso { background: #fef3c7; color: #92400e; }
        .badge-estatus.sin-estatus { background: #f1f5f9; color: #475569; }

        .footer { text-align: center; color: #94a3b8; font-size: 13px; padding: 16px 0 4px 0; border-top: 1px solid #e9eef3; margin-top: 8px; }

        @media (max-width: 1100px) { .chart-grid { grid-template-columns: repeat(2, 1fr); } }
        @media (max-width: 768px) {
            .chart-grid { grid-template-columns: 1fr; }
            .kpi-grid { grid-template-columns: repeat(2, 1fr); }
            .header { flex-direction: column; align-items: flex-start; gap: 8px; }
            .filters { flex-direction: column; align-items: stretch; }
            .filters .btn { margin-left: 0; margin-top: 8px; }
            .file-upload-section { flex-direction: column; align-items: stretch; }
            .file-upload-section .btn-upload, .file-upload-section .btn-clear { width: 100%; text-align: center; }
            table { font-size: 11px; }
            th, td { padding: 6px 8px; }
            #map { height: 280px; }
            .kpi-card .value { font-size: 26px; }
        }
        @media (max-width: 480px) { .kpi-grid { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
<div class="dashboard">

    <!-- HEADER -->
    <div class="header">
        <h1><i class="fas fa-chart-line"></i>Tracking de Servicios</h1>
        <div class="date"><i class="fas fa-calendar-alt"></i> <span id="fechaActual">Cargando...</span></div>
    </div>

    <!-- FILTROS -->
    <div class="filters">
        <label for="filterCompania">Compañía:</label>
        <select id="filterCompania">
            <option value="todas">Todas</option>
        </select>

        <label for="filterTipo">Tipo:</label>
        <select id="filterTipo">
            <option value="todos">Todos</option>
        </select>

        <label for="filterAsistencia">Asistencia:</label>
        <select id="filterAsistencia">
            <option value="todos">Todos</option>
        </select>

        <label for="filterAsignacion">Asignación:</label>
        <select id="filterAsignacion">
            <option value="todos">Todos</option>
        </select>

        <!-- AHORA ESTE SELECT SE LLENA DINÁMICAMENTE BASADO EN TUS DATOS REALES -->
        <label for="filterEstatus">Estatus:</label>
        <select id="filterEstatus">
            <option value="todos">Todos</option>
        </select>

        <label for="fechaDesde">Desde:</label>
        <input type="date" id="fechaDesde">
        <label for="fechaHasta">Hasta:</label>
        <input type="date" id="fechaHasta">

        <button class="btn" onclick="aplicarFiltros()"><i class="fas fa-filter"></i> Aplicar</button>
    </div>

    <!-- CARGA DE ARCHIVOS -->
    <div class="file-upload-section">
        <label><i class="fas fa-upload"></i> Cargar datos:</label>
        <input type="file" id="fileInput" accept=".csv,.xlsx,.xls">
        <button class="btn-upload" onclick="cargarArchivo()"><i class="fas fa-file-upload"></i> Cargar</button>
        <button class="btn-clear" onclick="limpiarCache()"><i class="fas fa-trash-alt"></i> Limpiar caché</button>
        <span class="file-status" id="fileStatus"><i class="fas fa-info-circle"></i> Sin datos cargados</span>
    </div>

    <!-- KPIs -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="label"><i class="fas fa-tasks"></i> Total Servicios</div>
            <div class="value" id="kpiTotal">0</div>
            <div class="sub">Registros filtrados</div>
        </div>
        <div class="kpi-card green">
            <div class="label"><i class="fas fa-check-circle"></i> Concluidos</div>
            <div class="value" id="kpiConcluidos">0</div>
            <div class="sub" id="kpiConcluidosPct">0%</div>
        </div>
        <div class="kpi-card orange">
            <div class="label"><i class="fas fa-hourglass-half"></i> En Proceso</div>
            <div class="value" id="kpiEnProceso">0</div>
            <div class="sub" id="kpiEnProcesoPct">0%</div>
        </div>
        <div class="kpi-card red">
            <div class="label"><i class="fas fa-times-circle"></i> No Otorgados</div>
            <div class="value" id="kpiNoOtorgados">0</div>
            <div class="sub" id="kpiNoOtorgadosPct">0%</div>
        </div>
    </div>

    <!-- GRÁFICOS -->
    <div class="chart-grid">
        <div class="chart-box">
            <h3><i class="fas fa-building"></i> Por Compañía</h3>
            <canvas id="chartCompania"></canvas>
        </div>
        <div class="chart-box">
            <h3><i class="fas fa-tags"></i> Por Tipo de Asistencia</h3>
            <canvas id="chartTipo"></canvas>
        </div>
        <div class="chart-box">
            <h3><i class="fas fa-tools"></i> Por Asistencia (servicio)</h3>
            <canvas id="chartAsistencia"></canvas>
        </div>
        <div class="chart-box">
            <h3><i class="fas fa-chart-bar"></i> Estatus General (Motivos)</h3>
            <canvas id="chartEstatus"></canvas>
        </div>
        <div class="chart-box">
            <h3><i class="fas fa-ban"></i> Motivos de No Otorgado</h3>
            <canvas id="chartMotivos"></canvas>
        </div>
        <div class="chart-box">
            <h3><i class="fas fa-tasks"></i> Asignación Final</h3>
            <canvas id="chartAsignacion"></canvas>
        </div>
    </div>

    <!-- MAPA -->
    <div class="map-wrapper">
        <h3><i class="fas fa-map-marked-alt"></i> Ubicación de Servicios (Origen)</h3>
        <div id="map"></div>
        <div class="map-legend">
            <span><span class="dot green"></span> Concluido</span>
            <span><span class="dot orange"></span> En Proceso</span>
            <span><span class="dot red"></span> No Otorgado</span>
            <span><span class="dot grey"></span> Sin Estatus</span>
        </div>
    </div>

    <!-- TABLA -->
    <div class="table-wrapper">
        <h3><i class="fas fa-list"></i> Detalle de Servicios (Tracking)</h3>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Compañía</th>
                    <th>Tipo</th>
                    <th>Asistencia</th>
                    <th>Asignación</th>
                    <th>Estatus</th>
                    <th>Fecha</th>
                </tr>
            </thead>
            <tbody id="tbodyServicios"></tbody>
        </table>
        <p style="margin-top:12px; font-size:13px; color:#94a3b8;">
            <i class="fas fa-info-circle"></i> Mostrando los primeros 50 registros.
        </p>
    </div>

    <div class="footer">
        <i class="fas fa-sync-alt"></i> Datos actualizados al <span id="fechaFooter">...</span> &nbsp;|&nbsp;
        <i class="fas fa-database"></i> Fuente: <span id="fuenteDatos">Sin datos</span>
    </div>
</div>

<script>
    // ========================================================================
    //  1. FUNCIÓN PARA FORMATEAR NÚMEROS CON SEPARADOR DE MILES
    // ========================================================================
    function formatearNumero(numero) {
        if (numero === undefined || numero === null || isNaN(numero)) return '0';
        return Number(numero).toLocaleString('es-ES');
    }

    // ========================================================================
    //  2. FUNCIONES PARA INDEXEDDB
    // ========================================================================
    const DB_NAME = 'ServiciosDB';
    const STORE_NAME = 'servicios';
    let db = null;

    function abrirDB() {
        return new Promise((resolve, reject) => {
            const request = indexedDB.open(DB_NAME, 2);
            request.onupgradeneeded = (e) => {
                const db = e.target.result;
                if (!db.objectStoreNames.contains(STORE_NAME)) {
                    const store = db.createObjectStore(STORE_NAME, { keyPath: 'id' });
                    store.createIndex('compania', 'compania', { unique: false });
                    store.createIndex('estatus', 'estatus', { unique: false });
                }
            };
            request.onsuccess = (e) => {
                db = e.target.result;
                resolve(db);
            };
            request.onerror = (e) => {
                console.error('❌ Error al abrir IndexedDB:', e.target.error);
                reject(e.target.error);
            };
        });
    }

    async function guardarDatosEnIndexedDB(datos) {
        try {
            if (!db) await abrirDB();
            const tx = db.transaction(STORE_NAME, 'readwrite');
            const store = tx.objectStore(STORE_NAME);
            store.clear();
            datos.forEach(d => {
                if (!d.id || d.id === '' || d.id === null) {
                    d.id = `CAS${Date.now()}_${Math.random().toString(36).substr(2, 5)}`;
                }
                store.put(d);
            });
            await new Promise((resolve, reject) => {
                tx.oncomplete = () => resolve();
                tx.onerror = (e) => reject(e.target.error);
            });
            console.log(`✅ Datos guardados en IndexedDB (${datos.length} registros)`);
            return true;
        } catch (e) {
            console.error('❌ Error al guardar en IndexedDB:', e);
            return false;
        }
    }

    async function cargarDatosDesdeIndexedDB() {
        try {
            if (!db) await abrirDB();
            const tx = db.transaction(STORE_NAME, 'readonly');
            const store = tx.objectStore(STORE_NAME);
            const all = await new Promise((resolve, reject) => {
                const request = store.getAll();
                request.onsuccess = () => resolve(request.result);
                request.onerror = (e) => reject(e.target.error);
            });
            console.log(`📂 Datos recuperados de IndexedDB: ${all.length} registros`);
            return all;
        } catch (e) {
            return null;
        }
    }

    async function limpiarCache() {
        if (confirm('¿Estás seguro de que quieres eliminar los datos guardados en caché?')) {
            try {
                if (!db) await abrirDB();
                const tx = db.transaction(STORE_NAME, 'readwrite');
                const store = tx.objectStore(STORE_NAME);
                store.clear();
                await new Promise((resolve, reject) => {
                    tx.oncomplete = () => resolve();
                    tx.onerror = (e) => reject(e.target.error);
                });
                datosCompletos = [];
                datosFiltrados = [];
                document.getElementById('fileStatus').innerHTML = '<i class="fas fa-info-circle"></i> Caché limpiado. Carga un archivo para empezar.';
                document.getElementById('fileStatus').style.color = '#64748b';
                document.getElementById('fuenteDatos').textContent = 'Sin datos';
                aplicarFiltros();
                if (markerLayer) markerLayer.clearLayers();
                console.log('🗑️ Caché limpiado');
            } catch (e) {
                alert('No se pudo limpiar la caché.');
            }
        }
    }

    // ========================================================================
    //  4. PROCESAR DATOS CARGADOS (mapeo de columnas)
    // ========================================================================
    function procesarDatos(rawData) {
        const headers = Object.keys(rawData[0]);
        console.log('📋 Columnas detectadas en el archivo:', headers);

        const aliasMap = {
            'id': ['id', 'ID', 'Id', 'folio', 'Folio', 'folio_servicio', 'id_cas', 'ID_CAS', 'Id_Cas'],
            'compania': ['compania', 'compañia', 'Compañía', 'company', 'aseguradora'],
            'tipoasistencia': ['tipoasistencia', 'tipo_asistencia', 'tipo', 'Tipo'],
            'asistencia': ['asistencia', 'servicio', 'tipo_servicio'],
            'asignacion_final': [
                'asignacion_final', 'asignacion', 'Asignación', 'asignación',
                'asignacion final', 'asignación final', 'Asignación Final',
                'ASIGNACION', 'ASIGNACIÓN', 'ASIGNACION_FINAL'
            ],
            'estatus': ['estatus', 'estado', 'status', 'estatus_reporte', 'estatus_servicio'],
            'motivo': ['motivo', 'razon', 'motivo_rechazo'],
            'en_proceso': ['en_proceso', 'proceso', 'enproceso'],
            'latorigen': ['latorigen', 'lat_origen', 'origen_lat'],
            'lonorigen': ['lonorigen', 'lon_origen', 'lng_origen', 'origen_lng'],
            'fecha': ['fecha', 'Fecha', 'fecha_servicio', 'date', 'Date']
        };

        function findColumn(headers, aliases) {
            for (let alias of aliases) {
                const found = headers.find(h => h.toLowerCase().trim() === alias.toLowerCase().trim());
                if (found) return found;
            }
            for (let alias of aliases) {
                const found = headers.find(h => h.toLowerCase().includes(alias.toLowerCase().trim()));
                if (found) return found;
            }
            return null;
        }

        const realMap = {};
        for (let [prop, aliases] of Object.entries(aliasMap)) {
            const col = findColumn(headers, aliases);
            if (col) realMap[prop] = col;
        }

        console.log('🔍 Mapeo de columnas detectado:', realMap);

        if (!realMap.id) {
            const posibleId = headers.find(h => h.toLowerCase().includes('id') && h.toLowerCase().includes('cas'));
            if (posibleId) realMap.id = posibleId;
        }

        const processed = rawData.map((row, index) => {
            const obj = {};
            for (let [prop, col] of Object.entries(realMap)) {
                let value = row[col];
                if (typeof value === 'string') {
                    value = value.trim();
                    if (value === '' || value === 'NULL' || value === 'null') value = null;
                }
                if (prop === 'en_proceso') {
                    if (typeof value === 'string') value = value.toLowerCase() === 'true' || value === '1' || value === 'si' || value === 'sí';
                    else if (typeof value === 'number') value = value === 1;
                }
                if (prop === 'latorigen' || prop === 'lonorigen') {
                    if (typeof value === 'string') value = parseFloat(value.replace(',', '.'));
                    if (isNaN(value)) value = null;
                }
                if (prop === 'fecha' && typeof value === 'number') {
                    try {
                        const date = new Date((value - 25569) * 86400 * 1000);
                        value = date.toISOString().split('T')[0];
                    } catch (e) { value = null; }
                }
                if (prop === 'fecha' && typeof value === 'string' && value.includes('/')) {
                    try {
                        const parts = value.split('/');
                        if (parts.length === 3) {
                            const day = parts[0].padStart(2, '0');
                            const month = parts[1].padStart(2, '0');
                            const year = parts[2];
                            value = `${year}-${month}-${day}`;
                        }
                    } catch (e) {}
                }
                obj[prop] = value;
            }

            if (!obj.id || obj.id === '' || obj.id === null || obj.id === 'null') {
                const possibleIdKey = Object.keys(row).find(k => k.toLowerCase().includes('id') && k.toLowerCase().includes('cas'));
                if (possibleIdKey) obj.id = row[possibleIdKey] ? String(row[possibleIdKey]).trim() : null;
                if (!obj.id || obj.id === '' || obj.id === 'null') obj.id = `CAS${Date.now()}_${Math.random().toString(36).substr(2, 5)}`;
            }

            if (!obj.compania) obj.compania = 'Desconocida';
            if (!obj.tipoasistencia) obj.tipoasistencia = 'Sin tipo';
            if (!obj.asistencia) obj.asistencia = 'Sin asistencia';
            if (!obj.asignacion_final) obj.asignacion_final = 'Sin asignar';
            if (!obj.motivo) obj.motivo = '';
            if (obj.en_proceso === undefined) obj.en_proceso = false;
            if (!obj.fecha) obj.fecha = new Date().toISOString().split('T')[0];
            
            // --- CORRECCIÓN CLAVE ---
            // Si no tiene estatus, NO forzarlo a NO OTORGADO. Poner "SIN ESTATUS"
            if (!obj.estatus || obj.estatus.trim() === '') {
                obj.estatus = 'SIN ESTATUS';
            }

            return obj;
        });

        return processed;
    }

    // ========================================================================
    //  5. CARGAR ARCHIVO CSV O EXCEL
    // ========================================================================
    function cargarArchivo() {
        const fileInput = document.getElementById('fileInput');
        const file = fileInput.files[0];
        if (!file) {
            alert('Por favor, selecciona un archivo CSV o Excel (.xlsx) primero.');
            return;
        }

        const status = document.getElementById('fileStatus');
        status.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Procesando archivo...';
        status.style.color = '#f59e0b';

        const reader = new FileReader();
        const extension = file.name.split('.').pop().toLowerCase();

        if (extension === 'csv') {
            reader.onload = function(e) {
                try {
                    const text = e.target.result;
                    const lines = text.split('\n').filter(line => line.trim());
                    if (lines.length < 2) throw new Error('El archivo CSV está vacío o no tiene encabezados.');

                    const headers = lines[0].split(',').map(h => h.trim());
                    const rawData = [];
                    for (let i = 1; i < lines.length; i++) {
                        const values = lines[i].split(',').map(v => v.trim());
                        const obj = {};
                        headers.forEach((h, idx) => { obj[h] = values[idx] || ''; });
                        rawData.push(obj);
                    }
                    const datos = procesarDatos(rawData);
                    actualizarDashboardConDatos(datos, 'CSV');
                    status.innerHTML = `<i class="fas fa-check-circle" style="color:#22c55e;"></i> ✅ ${formatearNumero(datos.length)} registros cargados desde CSV`;
                    status.style.color = '#22c55e';
                } catch (error) {
                    status.innerHTML = `<i class="fas fa-exclamation-circle" style="color:#ef4444;"></i> ❌ Error: ${error.message}`;
                    status.style.color = '#ef4444';
                }
            };
            reader.readAsText(file);
        } else if (extension === 'xlsx' || extension === 'xls') {
            reader.onload = function(e) {
                try {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, { type: 'array' });
                    const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
                    const rawData = XLSX.utils.sheet_to_json(firstSheet);
                    if (!rawData || rawData.length === 0) throw new Error('El archivo Excel está vacío.');
                    const datos = procesarDatos(rawData);
                    actualizarDashboardConDatos(datos, 'Excel');
                    status.innerHTML = `<i class="fas fa-check-circle" style="color:#22c55e;"></i> ✅ ${formatearNumero(datos.length)} registros cargados desde Excel`;
                    status.style.color = '#22c55e';
                } catch (error) {
                    status.innerHTML = `<i class="fas fa-exclamation-circle" style="color:#ef4444;"></i> ❌ Error: ${error.message}`;
                    status.style.color = '#ef4444';
                }
            };
            reader.readAsArrayBuffer(file);
        } else {
            status.innerHTML = `<i class="fas fa-exclamation-circle" style="color:#ef4444;"></i> ❌ Formato no soportado. Usa CSV o Excel (.xlsx)`;
            status.style.color = '#ef4444';
        }
    }

    // ========================================================================
    //  6. ACTUALIZAR DASHBOARD CON NUEVOS DATOS Y GUARDAR EN INDEXEDDB
    // ========================================================================
    async function actualizarDashboardConDatos(datos, fuente = 'archivo') {
        if (!datos || datos.length === 0) {
            alert('No se pudieron cargar datos válidos.');
            return;
        }
        await guardarDatosEnIndexedDB(datos);
        datosCompletos = datos;
        datosFiltrados = [...datosCompletos];
        poblarFiltros(datosCompletos);
        aplicarFiltros();
        document.getElementById('fuenteDatos').textContent = fuente === 'IndexedDB' ? 'Caché local (IndexedDB)' : `Archivo ${fuente}`;
    }

    // ========================================================================
    //  7. POBLAR DROPDOWNS DINÁMICAMENTE
    // ========================================================================
    function poblarFiltros(datos) {
        const companias = [...new Set(datos.map(d => d.compania).filter(Boolean))].sort();
        const selectCompania = document.getElementById('filterCompania');
        selectCompania.innerHTML = '<option value="todas">Todas</option>';
        companias.forEach(c => selectCompania.appendChild(new Option(c, c)));

        const tipos = [...new Set(datos.map(d => d.tipoasistencia).filter(Boolean))].sort();
        const selectTipo = document.getElementById('filterTipo');
        selectTipo.innerHTML = '<option value="todos">Todos</option>';
        tipos.forEach(t => selectTipo.appendChild(new Option(t, t)));

        const asistencias = [...new Set(datos.map(d => d.asistencia).filter(Boolean))].sort();
        const selectAsistencia = document.getElementById('filterAsistencia');
        selectAsistencia.innerHTML = '<option value="todos">Todos</option>';
        asistencias.forEach(a => selectAsistencia.appendChild(new Option(a, a)));

        const asignaciones = [...new Set(datos.map(d => d.asignacion_final).filter(Boolean))].sort();
        const selectAsignacion = document.getElementById('filterAsignacion');
        selectAsignacion.innerHTML = '<option value="todos">Todos</option>';
        asignaciones.forEach(a => selectAsignacion.appendChild(new Option(a, a)));

        // --- CORRECCIÓN CLAVE ---
        // El dropdown de Estatus se llena con los datos reales que vengan (incluyendo SIN ESTATUS si hay)
        const estatuses = [...new Set(datos.map(d => d.estatus).filter(Boolean))].sort();
        const selectEstatus = document.getElementById('filterEstatus');
        selectEstatus.innerHTML = '<option value="todos">Todos</option>';
        estatuses.forEach(e => selectEstatus.appendChild(new Option(e, e)));
    }

    // ========================================================================
    //  8. DATOS GLOBALES Y MAPA
    // ========================================================================
    let datosCompletos = [];
    let datosFiltrados = [];
    let chartCompania, chartTipo, chartAsistencia, chartEstatus, chartMotivos, chartAsignacion;
    let map, markerLayer;

    function initMap() {
        if (!map) {
            map = L.map('map').setView([19.4326, -99.1332], 10);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors'
            }).addTo(map);
            markerLayer = L.layerGroup().addTo(map);
        }
    }

    function actualizarMapa(datos) {
        if (!map) return;
        if (markerLayer) markerLayer.clearLayers();

        const conCoordenadas = datos.filter(d =>
            d.latorigen !== undefined && d.latorigen !== null && !isNaN(d.latorigen) &&
            d.lonorigen !== undefined && d.lonorigen !== null && !isNaN(d.lonorigen)
        );
        if (conCoordenadas.length === 0) return;

        // Lógica de colores del mapa más inteligente
        const getColor = (d) => {
            const e = d.estatus?.toUpperCase() || '';
            if ((e === 'OTORGADO' && !d.en_proceso) || e === 'CONCLUIDO' || e === 'TERMINADO') return '#22c55e'; // Verde
            if ((e === 'OTORGADO' && d.en_proceso) || e === 'EN PROCESO' || e === 'PROCESO') return '#f59e0b'; // Naranja
            if (e === 'NO OTORGADO' || e === 'CANCELADO' || e === 'RECHAZADO') return '#ef4444'; // Rojo
            return '#64748b'; // Gris (SIN ESTATUS o CUALQUIER OTRO)
        };

        const getStatusLabel = (d) => {
            const e = d.estatus?.toUpperCase() || '';
            if ((e === 'OTORGADO' && !d.en_proceso) || e === 'CONCLUIDO' || e === 'TERMINADO') return 'CONCLUIDO';
            if ((e === 'OTORGADO' && d.en_proceso) || e === 'EN PROCESO' || e === 'PROCESO') return 'EN PROCESO';
            if (e === 'NO OTORGADO' || e === 'CANCELADO' || e === 'RECHAZADO') return 'NO OTORGADO';
            return d.estatus || 'SIN ESTATUS';
        };

        const markers = [];
        conCoordenadas.forEach(d => {
            const color = getColor(d);
            const label = getStatusLabel(d);
            const marker = L.circleMarker([d.latorigen, d.lonorigen], {
                radius: 7, fillColor: color, color: '#fff', weight: 1.5, opacity: 1, fillOpacity: 0.85
            });
            const popupContent = `
                <strong>${d.id}</strong><br>
                <b>Compañía:</b> ${d.compania}<br>
                <b>Tipo:</b> ${d.tipoasistencia}<br>
                <b>Asistencia:</b> ${d.asistencia}<br>
                <b>Estatus:</b> <span style="color:${color};font-weight:bold;">${label}</span>
                <br><b>Fecha:</b> ${d.fecha || 'N/A'}
            `;
            marker.bindPopup(popupContent);
            markerLayer.addLayer(marker);
            markers.push(marker);
        });

        if (markers.length > 0) {
            try { map.fitBounds(L.featureGroup(markers).getBounds().pad(0.1)); } catch (e) {}
        }
    }

    // ========================================================================
    //  11. FILTRADO
    // ========================================================================
    function aplicarFiltros() {
        const compania = document.getElementById('filterCompania').value;
        const tipo = document.getElementById('filterTipo').value;
        const asistencia = document.getElementById('filterAsistencia').value;
        const asignacion = document.getElementById('filterAsignacion').value;
        const estatus = document.getElementById('filterEstatus').value;
        const fechaDesde = document.getElementById('fechaDesde').value;
        const fechaHasta = document.getElementById('fechaHasta').value;

        if (datosCompletos.length === 0) {
            datosFiltrados = [];
        } else {
            datosFiltrados = datosCompletos.filter(d => {
                if (compania !== 'todas' && d.compania?.toLowerCase().trim() !== compania.toLowerCase().trim()) return false;
                if (tipo !== 'todos' && d.tipoasistencia?.toLowerCase().trim() !== tipo.toLowerCase().trim()) return false;
                if (asistencia !== 'todos' && d.asistencia?.toLowerCase().trim() !== asistencia.toLowerCase().trim()) return false;
                if (asignacion !== 'todos' && d.asignacion_final?.toLowerCase().trim() !== asignacion.toLowerCase().trim()) return false;
                if (estatus !== 'todos' && d.estatus !== estatus) return false;

                if (d.fecha) {
                    if (fechaDesde && d.fecha < fechaDesde) return false;
                    if (fechaHasta && d.fecha > fechaHasta) return false;
                } else if (fechaDesde || fechaHasta) return false;
                
                return true;
            });
        }
        actualizarDashboard();
        actualizarMapa(datosFiltrados);
    }

    // ========================================================================
    //  12. ACTUALIZAR DASHBOARD (KPIs, gráficos, tabla)
    // ========================================================================
    function actualizarDashboard() {
        const total = datosFiltrados.length;
        
        // --- CORRECCIÓN CLAVE EN KPIs ---
        // Ampliamos la lectura para captar variantes de tu excel automáticamente
        const concluidos = datosFiltrados.filter(d => {
            const e = d.estatus?.toUpperCase() || '';
            return (e === 'OTORGADO' && !d.en_proceso) || e === 'CONCLUIDO' || e === 'TERMINADO';
        });
        const enProceso = datosFiltrados.filter(d => {
            const e = d.estatus?.toUpperCase() || '';
            return (e === 'OTORGADO' && d.en_proceso) || e === 'EN PROCESO' || e === 'PROCESO';
        });
        const noOtorgados = datosFiltrados.filter(d => {
            const e = d.estatus?.toUpperCase() || '';
            return e === 'NO OTORGADO' || e === 'CANCELADO' || e === 'RECHAZADO';
        });

        document.getElementById('kpiTotal').textContent = formatearNumero(total);
        document.getElementById('kpiConcluidos').textContent = formatearNumero(concluidos.length);
        document.getElementById('kpiConcluidosPct').textContent = total > 0 ? ((concluidos.length / total) * 100).toFixed(1) + '%' : '0%';
        document.getElementById('kpiEnProceso').textContent = formatearNumero(enProceso.length);
        document.getElementById('kpiEnProcesoPct').textContent = total > 0 ? ((enProceso.length / total) * 100).toFixed(1) + '%' : '0%';
        document.getElementById('kpiNoOtorgados').textContent = formatearNumero(noOtorgados.length);
        document.getElementById('kpiNoOtorgadosPct').textContent = total > 0 ? ((noOtorgados.length / total) * 100).toFixed(1) + '%' : '0%';

        const now = new Date().toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
        document.getElementById('fechaActual').textContent = now;
        document.getElementById('fechaFooter').textContent = now;

        // Gráficos
        const compMap = {};
        datosFiltrados.forEach(d => { compMap[d.compania] = (compMap[d.compania] || 0) + 1; });
        updateChart(chartCompania, Object.keys(compMap), Object.values(compMap), ['#2563eb','#22c55e','#f59e0b','#8b5cf6','#ec4899','#ef4444','#14b8a6','#f97316']);

        const tipoMap = {};
        datosFiltrados.forEach(d => { tipoMap[d.tipoasistencia] = (tipoMap[d.tipoasistencia] || 0) + 1; });
        updateChart(chartTipo, Object.keys(tipoMap), Object.values(tipoMap), ['#e67e22','#2c3e50','#16a085','#7f8c8d','#2980b9','#8e44ad','#d35400']);

        const asisMap = {};
        datosFiltrados.forEach(d => { asisMap[d.asistencia] = (asisMap[d.asistencia] || 0) + 1; });
        updateChart(chartAsistencia, Object.keys(asisMap), Object.values(asisMap), ['#3b82f6','#22c55e','#f59e0b','#8b5cf6','#ec4899','#06b6d4','#f97316','#14b8a6','#e74c3c','#8e44ad']);

        // Gráfico de Estatus General (Motivos)
        const motivoGeneralMap = {};
        datosFiltrados.forEach(d => {
            let mot = (d.motivo && d.motivo.trim() !== '') ? d.motivo.trim() : 'Sin Motivo (Exitoso)';
            motivoGeneralMap[mot] = (motivoGeneralMap[mot] || 0) + 1;
        });

        const motivoGeneralSorted = Object.entries(motivoGeneralMap).sort((a, b) => b[1] - a[1]);
        const estatusLabels = motivoGeneralSorted.map(item => item[0]);
        const estatusData = motivoGeneralSorted.map(item => item[1]);

        const estatusColors = estatusLabels.map((lbl, i) => {
            if (lbl === 'Sin Motivo (Exitoso)') return '#22c55e'; // Verde
            const paleta = ['#ef4444', '#f59e0b', '#3b82f6', '#8b5cf6', '#ec4899', '#f97316', '#14b8a6', '#64748b'];
            return paleta[i % paleta.length];
        });

        if (estatusLabels.length === 0) {
            updateChart(chartEstatus, ['Sin datos'], [1], ['#94a3b8']);
        } else {
            updateChart(chartEstatus, estatusLabels, estatusData, estatusColors);
        }

        // Gráfico de Motivos (Solo de los no otorgados/rechazados)
        const motivoMap = {};
        noOtorgados.forEach(d => { 
            let m = (d.motivo && d.motivo.trim() !== '') ? d.motivo.trim() : 'No especificado';
            motivoMap[m] = (motivoMap[m] || 0) + 1; 
        });
        const motivoLabels = Object.keys(motivoMap);
        const motivoData = Object.values(motivoMap);
        if (motivoLabels.length === 0) {
            updateChart(chartMotivos, ['Sin datos'], [1], ['#94a3b8']);
        } else {
            updateChart(chartMotivos, motivoLabels, motivoData, ['#ef4444','#f59e0b','#94a3b8','#3b82f6','#8b5cf6','#22c55e']);
        }

        const asigMap = {};
        datosFiltrados.forEach(d => { asigMap[d.asignacion_final] = (asigMap[d.asignacion_final] || 0) + 1; });
        updateChart(chartAsignacion, Object.keys(asigMap), Object.values(asigMap), ['#8b5cf6','#f59e0b','#22c55e','#3b82f6']);

        // Tabla
        const tbody = document.getElementById('tbodyServicios');
        const mostrar = datosFiltrados.slice(0, 50);
        if (mostrar.length === 0) {
            tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; color:#94a3b8; padding:30px 0;">No hay servicios con los filtros seleccionados.</td></tr>`;
        } else {
            let html = '';
            mostrar.forEach(d => {
                let badge = '';
                const e = d.estatus?.toUpperCase() || '';

                if ((e === 'OTORGADO' && !d.en_proceso) || e === 'CONCLUIDO' || e === 'TERMINADO') {
                    badge = '<span class="badge-estatus otorgado">CONCLUIDO</span>';
                } else if ((e === 'OTORGADO' && d.en_proceso) || e === 'EN PROCESO' || e === 'PROCESO') {
                    badge = '<span class="badge-estatus proceso">EN PROCESO</span>';
                } else if (e === 'NO OTORGADO' || e === 'CANCELADO' || e === 'RECHAZADO') {
                    badge = '<span class="badge-estatus no-otorgado">NO OTORGADO</span>';
                } else {
                    badge = `<span class="badge-estatus sin-estatus">${d.estatus}</span>`;
                }

                const fechaStr = d.fecha ? d.fecha : 'N/A';
                html += `<tr>
                            <td><strong>${d.id}</strong></td>
                            <td>${d.compania}</td>
                            <td>${d.tipoasistencia}</td>
                            <td>${d.asistencia}</td>
                            <td>${d.asignacion_final}</td>
                            <td>${badge}</td>
                            <td>${fechaStr}</td>
                        </tr>`;
            });
            tbody.innerHTML = html;
        }
    }

    // ========================================================================
    //  13. ACTUALIZAR GRÁFICO
    // ========================================================================
    function updateChart(chartInstance, labels, data, colors) {
        if (!chartInstance) return;
        if (data.length === 0) {
            chartInstance.data.labels = ['Sin datos'];
            chartInstance.data.datasets[0].data = [1];
            chartInstance.data.datasets[0].backgroundColor = ['#94a3b8'];
            chartInstance.update();
            return;
        }
        chartInstance.data.labels = labels;
        chartInstance.data.datasets[0].data = data;
        chartInstance.data.datasets[0].backgroundColor = colors.slice(0, data.length);
        chartInstance.update();
    }

    // ========================================================================
    //  14. INICIALIZAR - CARGAR DESDE INDEXEDDB SI EXISTE
    // ========================================================================
    async function init() {
        initMap();
        const emptyData = [0];
        const emptyLabels = ['Sin datos'];

        chartCompania = new Chart(document.getElementById('chartCompania'), {
            type: 'bar',
            data: { labels: emptyLabels, datasets: [{ data: emptyData, backgroundColor: ['#94a3b8'] }] },
            options: { responsive: true, maintainAspectRatio: true, indexAxis: 'y', plugins: { legend: { display: false } } }
        });

        chartTipo = new Chart(document.getElementById('chartTipo'), {
            type: 'bar',
            data: { labels: emptyLabels, datasets: [{ data: emptyData, backgroundColor: ['#94a3b8'] }] },
            options: { responsive: true, maintainAspectRatio: true, indexAxis: 'y', plugins: { legend: { display: false } } }
        });

        chartAsistencia = new Chart(document.getElementById('chartAsistencia'), {
            type: 'bar',
            data: { labels: emptyLabels, datasets: [{ data: emptyData, backgroundColor: ['#94a3b8'] }] },
            options: { responsive: true, maintainAspectRatio: true, indexAxis: 'y', plugins: { legend: { display: false } } }
        });

        chartEstatus = new Chart(document.getElementById('chartEstatus'), {
            type: 'bar',
            data: { labels: emptyLabels, datasets: [{ data: emptyData, backgroundColor: ['#94a3b8'] }] },
            options: { responsive: true, maintainAspectRatio: true, indexAxis: 'y', plugins: { legend: { display: false } } }
        });

        chartMotivos = new Chart(document.getElementById('chartMotivos'), {
            type: 'bar',
            data: { labels: emptyLabels, datasets: [{ data: emptyData, backgroundColor: ['#94a3b8'] }] },
            options: { responsive: true, maintainAspectRatio: true, indexAxis: 'y', plugins: { legend: { display: false } } }
        });

        chartAsignacion = new Chart(document.getElementById('chartAsignacion'), {
            type: 'bar',
            data: { labels: emptyLabels, datasets: [{ data: emptyData, backgroundColor: ['#94a3b8'] }] },
            options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { display: false } } }
        });

        try {
            const datosGuardados = await cargarDatosDesdeIndexedDB();
            if (datosGuardados && datosGuardados.length > 0) {
                datosCompletos = datosGuardados;
                datosFiltrados = [...datosCompletos];
                poblarFiltros(datosCompletos);
                actualizarDashboard();
                actualizarMapa(datosFiltrados);
                document.getElementById('fileStatus').innerHTML =
                    `<i class="fas fa-database" style="color:#8b5cf6;"></i> 📂 ${formatearNumero(datosGuardados.length)} registros cargados desde caché local (IndexedDB)`;
                document.getElementById('fileStatus').style.color = '#8b5cf6';
                document.getElementById('fuenteDatos').textContent = 'Caché local (IndexedDB)';
            } else {
                datosCompletos = [];
                datosFiltrados = [];
                actualizarDashboard();
                document.getElementById('fuenteDatos').textContent = 'Sin datos';
            }
        } catch (error) {
            datosCompletos = [];
            datosFiltrados = [];
            actualizarDashboard();
            document.getElementById('fuenteDatos').textContent = 'Error al cargar caché';
        }

        const now = new Date().toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
        document.getElementById('fechaActual').textContent = now;
        document.getElementById('fechaFooter').textContent = now;
    }

    // ========================================================================
    //  15. EXPONER FUNCIONES
    // ========================================================================
    window.cargarArchivo = cargarArchivo;
    window.aplicarFiltros = aplicarFiltros;
    window.limpiarCache = limpiarCache;

    document.addEventListener('DOMContentLoaded', init);
</script>

